{
  "name": "elpis-property",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply elpis-property-staging-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply elpis-property-staging-db --remote",
    "test:phase5": "node --experimental-sqlite test_phase5_suite.mjs",
    "test:phase6": "node --experimental-sqlite test_phase6_suite.mjs",
    "test:phase7": "node --experimental-sqlite test_phase7_suite.mjs",
    "test:phase8": "node --experimental-sqlite test_phase8_suite.mjs",
    "test": "npm run test:phase5 && npm run test:phase6 && npm run test:phase7 && npm run test:phase8 && npm run test:seed && npm run test:voice && npm run test:browser",
    "test:seed": "node --experimental-sqlite test_seed_security.mjs",
    "test:browser": "node test_browser.mjs",
    "test:voice": "node test_voice_units.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "wrangler": "^4.157.0"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3"
  }
}
